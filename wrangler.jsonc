{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "happy-little-studio",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "bobross.prompthabbit.com",
      "custom_domain": true
    }
  ]
}
